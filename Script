--[[
    Полноценный скрипт меню для Tower of Hell (всё в одном файле)
    Создает интерфейс на клиенте и обрабатывает телепортацию на сервере.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- 1. Создание папки и события для связи клиента с сервером (если их нет)
local remotes = ReplicatedStorage:FindFirstChild("Remotes")
if not remotes then
	remotes = Instance.new("Folder")
	remotes.Name = "Remotes"
	remotes.Parent = ReplicatedStorage
end

local teleportEvent = remotes:FindFirstChild("TeleportToTop")
if not teleportEvent then
	teleportEvent = Instance.new("RemoteEvent")
	teleportEvent.Name = "TeleportToTop"
	teleportEvent.Parent = remotes
end

-- 2. Серверная логика телепортации
teleportEvent.OnServerEvent:Connect(function(player)
	local character = player.Character
	if not character then return end
	
	local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	
	if humanoidRootPart and humanoid and humanoid.Health > 0 then
		-- Телепортация на вершину башни (высота 500 стадов)
		humanoidRootPart.CFrame = CFrame.new(0, 500, 0)
		-- Сбрасываем инерцию и скорость падения
		humanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
	end
end)

-- 3. Автоматическое создание интерфейса для каждого игрока при входе
Players.PlayerAdded:Connect(function(player)
	local playerGui = player:WaitForChild("PlayerGui")
	
	-- Проверяем, не создан ли уже GUI
	if playerGui:FindFirstChild("MainMenuGui") then return end
	
	-- Главный контейнер GUI
	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "MainMenuGui"
	screenGui.IgnoreGuiInset = true
	screenGui.Parent = playerGui
	
	-- Задний фон меню (стиль ретро / темно-желтые тона)
	local background = Instance.new("Frame")
	background.Name = "MenuFrame"
	background.Size = UDim2.new(1, 0, 1, 0)
	background.BackgroundColor3 = Color3.fromRGB(45, 38, 28) -- Темно-коричневый ретро-фон
	background.BorderSizePixel = 0
	background.Parent = screenGui
	
	-- Большая кнопка START по центру
	local startButton = Instance.new("TextButton")
	startButton.Name = "StartButton"
	startButton.Size = UDim2.new(0, 280, 0, 80)
	startButton.Position = UDim2.new(0.5, -140, 0.5, -40) -- Точный центр экрана
	startButton.BackgroundColor3 = Color3.fromRGB(46, 204, 113) -- Ярко-зеленый цвет
	startButton.Text = "START"
	startButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	startButton.TextSize = 36
	startButton.Font = Enum.Font.FredokaOne
	startButton.Parent = background
	
	-- Скругление углов кнопки
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 14)
	corner.Parent = startButton
	
	-- Текст-заголовок (название игры слева, как на референсе)
	local titleLabel = Instance.new("TextLabel")
	titleLabel.Size = UDim2.new(0, 400, 0, 60)
	titleLabel.Position = UDim2.new(0.05, 0, 0.15, 0)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Text = "TOWER OF HELL"
	titleLabel.TextColor3 = Color3.fromRGB(241, 196, 15) -- Желтоватый стиль ретро
	titleLabel.TextSize = 42
	titleLabel.Font = Enum.Font.Black
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.Parent = background
	
	-- Дополнительные пункты меню для атмосферы
	local options = {"DOWNLOAD CONTENT", "ACHIEVEMENTS", "HELP & OPTIONS", "EXIT GAME"}
	for i, text in ipairs(options) do
		local optLabel = Instance.new("TextLabel")
		optLabel.Size = UDim2.new(0, 300, 0, 40)
		optLabel.Position = UDim2.new(0.05, 0, 0.25 + (i * 0.07), 0)
		optLabel.BackgroundTransparency = 1
		optLabel.Text = text
		optLabel.TextColor3 = Color3.fromRGB(200, 160, 100)
		optLabel.TextSize = 22
		optLabel.Font = Enum.Font.GothamBold
		optLabel.TextXAlignment = Enum.TextXAlignment.Left
		optLabel.Parent = background
	end
	
	-- 4. Клиентская логика обработки нажатия (внедряем через LocalScript с помощью ModuleScript/строки или дублируем логику клика)
-- Поскольку это Server Script, создаем LocalScript внутри PlayerGui для обработки нажатия мыши
	local localScriptCode = [[
		local button = script.Parent
		local screenGui = button.Parent.Parent
		local remotes = game:GetService("ReplicatedStorage"):WaitForChild("Remotes")
		local teleportEvent = remotes:WaitForChild("TeleportToTop")
		
		button.MouseButton1Click:Connect(function()
			screenGui.Enabled = false -- Скрываем меню
			teleportEvent:FireServer() -- Запрашиваем телепортацию у сервера
		end)
	]]
	
	-- Создаем LocalScript программно и отправляем игроку
	local loaderScript = Instance.new("LocalScript")
	loaderScript.Source = localScriptCode
	loaderScript.Parent = startButton
end)
