local function createToggleRow(parent, textKey, callback, hasSettings, settingsCallback)
    local row = Instance.new("Frame")
    row.Parent = parent
    row.BackgroundColor3 = Color3.fromRGB(18, 26, 42)
    row.BackgroundTransparency = 0.4
    row.Size = UDim2.new(1, -10, 0, 42)

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = row

    local label = Instance.new("TextLabel")
    label.Name = "Label"
    label.Parent = row
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0, 12, 0, 0)
    label.Size = UDim2.new(0, 210, 1, 0)
    label.Font = Enum.Font.SourceSansSemibold
    label.Text = T(textKey)
    label.TextColor3 = Color3.fromRGB(220, 225, 235)
    label.TextSize = 14
    label.TextXAlignment = Enum.TextXAlignment.Left

    table.insert(activeToggles, {Label = label, Key = t
extKey})

    if hasSettings then
        local gearBtn = Instance.new("TextButton")
        gearBtn.Parent = row
        gearBtn.BackgroundColor3 = Color3.fromRGB(35, 45, 65)
        gearBtn.Position = UDim2.new(1, -100, 0.5, -11)
        gearBtn.Size = UDim2.new(0, 42, 0, 22)
        gearBtn.Font = Enum.Font.SourceSansBold
        gearBtn.Text = "⚙ [MB1]"
        gearBtn.TextColor3 = Color3.fromRGB(200, 210, 225)
        gearBtn.TextSize = 11

        local gCorner = Instance.new("UICorner")
        gCorner.CornerRadius = UDim.new(0, 4)
        gCorner.Parent = gearBtn

        settingsCallback(gearBtn)
    end

    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Parent = row
    toggleBtn.BackgroundColor3 = Color3.fromRGB(45, 55, 75)
    toggleBtn.Position = UDim2.new(1, -50, 0.5, -11)
    toggleBtn.Size = UDim2.new(0, 40, 0, 22)
    toggleBtn.Text = ""

    local tCorner = Instance.new("UICorner")
    tCorner.CornerRadius = UDim.new(1, 0)
    tCorner.Parent = toggleBtn

    local circle = Instance.new("Frame")
    circle.Name = "Circle"
    circle.Parent = toggleBtn
    circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    circle.Position = UDim2.new(0, 2, 0.5, -9)
    circle.Size = UDim2.new(0, 18, 0, 18)

    local cCorner = Instance.new("UICorner")
    cCorner.CornerRadius = UDim.new(1, 0)
    cCorner.Parent = circle

    local state = false
    toggleBtn.MouseButton1Click:Connect(function()
        state = not state
        if state then
            toggleBtn.BackgroundColor3 = UIColors[currentTheme]
            circle:TweenPosition(UDim2.new(1, -20, 0.5, -9), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
        else
            toggleBtn.BackgroundColor3 = Color3.fromRGB(45, 55, 75)
            circle:TweenPosition(UDim2.new(0, 2, 0.5, -9), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
        end
        callback(state)
    end)

    return row
end

