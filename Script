local function addToggle(parent, key, cb)
    local row = Instance.new("Frame", parent)
    row.BackgroundColor3, row.BackgroundTransparency, row.Size = Color3.fromRGB(18, 26, 42), 0.4, UDim2.new(1, -10, 0, 42)
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)
    
    local lbl = Instance.new("TextLabel", row)
    lbl.BackgroundTransparency, lbl.Position, lbl.Size, lbl.Font, lbl.Text, lbl.TextColor3, lbl.TextSize, lbl.TextXAlignment = true, UDim2.new(0, 12, 0, 0), UDim2.new(1, -70, 1, 0), Enum.Font.SourceSansSemibold, T(key), Color3.fromRGB(220, 225, 235), 14, Enum.TextXAlignment.Left
    
    local btn = Instance.new("TextButton", row)
    btn.BackgroundColor3, btn.Position, btn.Size, btn.Text = Color3.fromRGB(45, 55, 75), UDim2.new(1, -50, 0.5, -11), UDim2.new(0, 40, 0, 22), ""
    Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)
    
    local circ = Instance.new("Frame", btn)
    circ.BackgroundColor3, circ.Position, circ.Size = Color3.new(1,1,1), UDim2.new(0, 2, 0.5, -9), UDim2.new(0, 18, 0, 18)
    Instance.new("UICorner", circ).CornerRadius = UDim.new(1, 0)
    
    local state = false
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.BackgroundColor3 = state and UIColors[currentTheme] or Color3.fromRGB(45, 55, 75)
        circ:TweenPosition(state and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9), Enum.EasingDirection.Out,
Enum.EasingStyle.Quad, 0.15, true)
        cb(state)
    end)
end

