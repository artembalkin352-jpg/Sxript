-- Функция флинга
local function toggleFlingPlayer(targetPlayer, startBtn)
    if activeFlings[targetPlayer] then
        activeFlings[targetPlayer] = false
        activeFlings[targetPlayer] = nil
        startBtn.Text = "START"
        startBtn.BackgroundColor3 = Color3.fromRGB(35, 45, 65)
        startBtn.TextColor3 = Color3.fromRGB(220, 225, 235)
        return
    end

    activeFlings[targetPlayer] = true
    startBtn.Text = "STOP"
    startBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
    startBtn.TextColor3 = Color3.fromRGB(255, 255, 255)

    task.spawn(function()
        while activeFlings[targetPlayer] do
            local targetChar = targetPlayer.Character
            local localChar = LocalPlayer.Character
            if not targetChar or not localChar then break end
            
            local tRoot = targetChar:FindFirstChild("HumanoidRootPart")
            local lRoot = localChar:FindFirstChild("HumanoidRootPart")
            if not tRoot or not lRoot then break end

            local bv = tRoot:FindFirstChild("ShershnevFlingBV")
            if not bv then
                bv = Instance.new("BodyVelocity")
                bv.Name = "ShershnevFlingBV"
                bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                bv.Parent = tRoot
            end
            
            bv.Velocity = Vector3.new(math.random(-9999, 9999), 99999, math.random(-9999, 9999))
            tRoot.CFrame = lRoot.CFrame * CFrame.new(0, 0, -2)
            
            task.wait(0.05)
        end
        
        local targetChar = targetPlayer.Character
        if targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
            local bv = targetChar.HumanoidRootPart:Find
FirstChild("ShershnevFlingBV")
            if bv then bv:Destroy() end
        end
    end)
end

