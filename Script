-- Переменные для анимации уведомления пистолета
local notificationActive = false

RunService.RenderStepped:Connect(function()
    -- ESP Игроков
    if _G.EspEnabled then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local char = player.Character
                local highlight = char:FindFirstChild("Highlight")
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Parent = char
                    highlight.Adornee = char
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                end
                
                local role = getRole(player)
                if role == "Murderer" then
                    highlight.FillColor = Color3.fromRGB(255, 0, 0)
                elseif role == "Sheriff" then
                    highlight.FillColor = Color3.fromRGB(0, 0, 255)
                else
                    highlight.FillColor = Color3.fromRGB(0, 255, 0)
                end
            end
        end
    else
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("Highlight") then
                p.Character.Highlight:Destroy()
            end
        end
    end

    -- Подсветка упавшего пистолета и плавная анимация уведомления
    local gunDropped = false
    if _G.GunEspEnabled then
        for _, obj in pairs(Workspace:GetChildren()) do
            if obj.Name == "Gun" or obj.Name == "Drop" then
                gunDropped = true
                local highlight = obj:FindFirstChild("GunHighlight")
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "GunHighlight"
                    highlight.Parent = obj
                    highlight.Adornee = obj
                    highlight.FillColor = Color3.fromRGB(255, 220, 0)
                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                end
            end
        end
    else
        for _, obj in pairs(Workspace:GetChildren()) do
            if (obj.Name == "Gun" or obj.Name == "Drop") and obj:FindFirstChild("GunHighlight") then
                obj.GunHighlight:Destroy()
            end
        end
    end

    if _G.GunEspEnabled and gunDropped then
        if not notificationActive then
            notificationActive = true
            GunNotifyLabel.Visible = true
            GunNotifyLabel:TweenPosition(UDim2.new(0.5, -175, 0.85, 0), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.4, true)
            
            task.spawn(function()
                task.wait(3)
                if notificationActive then
                    GunNotifyLabel:TweenPosition(UDim2.new(0.5, -175, 1.1, 0), Enum.EasingDirection.In, Enum.EasingStyle.Quad, 0.4, true)
                    task.wait(0.4)
                    if not gunDropped then
                        GunNotifyLabel.Visible = false
                    end
                end
            end)
        end
    else
        notificationActive = false
        GunNotifyLabel:TweenPosition(UDim2.new(0.5, -175, 1.1, 0), Enum.EasingDirection.In, Enum.EasingStyle.Quad, 0.3, true)
end

    -- Мгновенный Сайлент-Аим (без задержки по нажатию кнопки)
    if _G.SilentAimEnabled and isLocalSheriff() then
        local target = getClosestPlayerInsideFOV()
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            local mRoot = target.Character.HumanoidRootPart
            if isKeyPressed(silentAimKey) then
                local localChar = LocalPlayer.Character
                if localChar then
                    local gun = localChar:FindFirstChild("Gun") or (LocalPlayer.Backpack and LocalPlayer.Backpack:FindFirstChild("Gun"))
                    if gun then
                        -- Быстрое нацеливание и мгновенный выстрел без визуальной задержки камеры
                        pcall(function()
                            local args = {
                                [1] = mRoot.Position,
                                [2] = "Gun"
                            }
                            -- Вызов события выстрела оружия напрямую (если доступно в игре)
                            local remote = gun:FindFirstChild("Shoot") or gun:FindFirstChild("Events") and gun.Events:FindFirstChild("Shoot")
                            if remote then
                                remote:FireServer(mRoot.Position)
                            end
                        end)
                    end
                end
            end
        end
    end

    -- Плавный ПК Аимбот (Aimbot)
    if _G.AimbotEnabled and currentPlatform == "PC" then
        local target = getClosestPlayerInsideFOV()
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            local mRoot = target.Character.HumanoidRootPart
            if isKeyPressed(aimbotKey) then
                local targetCFrame = CFrame.new(Camera.CFrame.Position, mRoot.Position)
                Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, 0.15)
            end
        end
    end
end)
